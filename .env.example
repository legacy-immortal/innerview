# Frontend (Vite) - copy relevant values to .env for local dev/build
# For split deploys (e.g. Netlify web + Render API), set to the API origin:
# VITE_API_BASE_URL=https://your-api.onrender.com
VITE_API_BASE_URL=

# --- Server (loaded by server/src/config/env.ts from project root .env in dev) ---
NODE_ENV=development
PORT=3002
# CORS origin(s) allowed by API. For split deploy set to your web origin, e.g. https://your-site.netlify.app
CORS_ORIGIN=http://localhost:5173

# AI providers (configure as needed)
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ZEN_API_KEY=

# TTS feature flags
ENABLE_TTS_PROXY=false
ENABLE_VOICE_CLONING=false

# Storage / associative memory (Turso/libSQL)
# Local development (default): file-backed DB (no token needed)
TURSO_DATABASE_URL=file:server/data/local-vector.db
# TURSO_AUTH_TOKEN=
# Cloud (e.g. Turso remote) — set when ready (keep token server-side only)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
DATABASE_URL=
VECTOR_DB_URL=
