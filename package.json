{
  "name": "innerview",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "kill-ports": "bun scripts/kill-ports.ts",
    "check-resources": "bun scripts/check-resources.ts",
    "dev:client": "vite",
    "dev:server": "bun run --bun server/src/index.ts",
    "dev": "bun run check-resources && bun run kill-ports && concurrently -n frontend,backend -c cyan,magenta --kill-others-on-fail \"bun run dev:client\" \"bun run dev:server\"",
    "build": "tsc && vite build",
    "lint": "eslint \"**/*.{ts,tsx,js,jsx}\" --max-warnings 0",
    "lint:fix": "eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.112",
    "@ai-sdk/elevenlabs": "^2.0.73",
    "@ai-sdk/langchain": "^2.0.331",
    "@ai-sdk/openai": "^3.0.137",
    "@ai-sdk/provider": "^3.0.19",
    "@ai-sdk/provider-utils": "^3.0.44",
    "@ai-sdk/react": "^3.0.326",
    "@built-in-ai/core": "^2.1.0",
    "@built-in-ai/transformers-js": "^0.1.3",
    "@chakra-ui/react": "^3.38.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/three": "^0.181.0",
    "ai": "^6.0.323",
    "chalk": "^5.6.2",
    "es-toolkit": "^1.53.2",
    "framer-motion": "^12.43.0",
    "kokoro-js": "^1.2.1",
    "localforage": "^1.10.0",
    "marked": "^17.0.6",
    "marked-terminal": "^7.3.1",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-console-emulator": "^5.0.2",
    "react-dom": "^19.3.1",
    "react-hotkeys-hook": "^5.3.3",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.181.2",
    "tokenlens": "^1.3.1",
    "wavesurfer.js": "^7.12.12",
    "zod": "^4.6.6",
    "zustand": "^5.1.0"
  },
  "overrides": {
    "ai": "^6.0.70"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^4.3.2"
  }
}
