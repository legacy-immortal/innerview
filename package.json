{
  "name": "innerview",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "kill-ports": "bun scripts/kill-ports.ts",
    "check-resources": "bun scripts/check-resources.ts",
    "dev:client": "vite",
    "dev:server": "bun run --bun server/src/index.ts",
    "dev": "bun scripts/dev-native.ts",
    "dev:native": "bun scripts/dev-native.ts",
    "dev:docker": "bun scripts/dev-docker.ts",
    "docker:dev": "bun scripts/dev-docker.ts",
    "docker:up": "bun scripts/dev-docker.ts --detach",
    "docker:down": "sudo docker compose down --remove-orphans && bun scripts/kill-ports.ts --port 3002",
    "build": "tsc && vite build",
    "lint": "eslint \"**/*.{ts,tsx,js,jsx}\" --max-warnings 0",
    "lint:fix": "eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:sentinel": "bun e2e/sentinel.ts",
    "test:e2e:typecheck": "tsc -p e2e/tsconfig.json --noEmit",
    "test:e2e:ui": "E2E_REQUIRE_REMOTE_VLLM=0 bunx playwright test --config=e2e/playwright.config.ts e2e/smoke.ui.spec.ts",
    "test:e2e:agentic": "bun run test:e2e:sentinel && bunx playwright test --config=e2e/playwright.config.ts e2e/smoke.agentic.spec.ts",
    "test:e2e": "bun run test:e2e:agentic",
    "test:e2e:all": "bun run test:e2e:ui && bun run test:e2e:agentic",
    "render:diagnostics": "bun scripts/render-diagnostics.ts",
    "render:summary": "bun scripts/render-diagnostics.ts summary",
    "build:pages": "VITE_API_BASE_URL=${VITE_API_BASE_URL:-https://innerview.onrender.com} bun run build && bun scripts/prune-pages-dist.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.97",
    "@ai-sdk/elevenlabs": "^3.0.80",
    "@ai-sdk/langchain": "^3.0.166",
    "@ai-sdk/openai": "^4.0.109",
    "@ai-sdk/provider": "^3.0.19",
    "@ai-sdk/react": "^3.0.326",
    "@browserbasehq/stagehand": "^4.4.0",
    "@built-in-ai/core": "^2.1.0",
    "@built-in-ai/transformers-js": "^1.1.2",
    "@chakra-ui/react": "^3.38.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@huggingface/transformers": "^4.3.2",
    "@langchain/classic": "^1.0.57",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.3.5",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/three": "^0.181.0",
    "ai": "6.0.323",
    "chalk": "^5.6.2",
    "es-toolkit": "^1.53.2",
    "framer-motion": "^12.43.0",
    "kokoro-js": "^1.2.1",
    "leva": "^0.10.1",
    "localforage": "^1.10.0",
    "marked": "^17.0.6",
    "marked-terminal": "^7.3.1",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-console-emulator": "^5.0.2",
    "react-dom": "^19.3.1",
    "react-hotkeys-hook": "^5.3.3",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.181.2",
    "tokenlens": "^1.3.1",
    "wavesurfer.js": "^7.12.12",
    "zod": "^4.6.6",
    "zustand": "^5.1.0"
  },
  "overrides": {},
  "devDependencies": {
    "@ai-sdk/provider-utils": "^5.0.75",
    "@eslint/js": "^9.39.5",
    "@midscene/web": "^1.17.7",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript-eslint/typescript-estree": "^8.72.1",
    "@typescript-eslint/utils": "^8.72.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "dotenv": "^18.0.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^5.1.0"
  }
}
