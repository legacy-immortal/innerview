{
  "name": "innerview",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "kill-ports": "bun scripts/kill-ports.ts",
    "dev:client": "vite",
    "dev:server": "bun run --bun server/src/index.ts",
    "dev": "bun run kill-ports && concurrently -n frontend,backend -c cyan,magenta --kill-others-on-fail \"bun run dev:client\" \"bun run dev:server\"",
    "build": "tsc && vite build",
    "lint": "eslint \"**/*.{ts,tsx,js,jsx}\" --max-warnings 0",
    "lint:fix": "eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.43",
    "@ai-sdk/elevenlabs": "^2.0.17",
    "@ai-sdk/langchain": "^2.0.75",
    "@ai-sdk/openai": "^3.0.25",
    "@ai-sdk/provider": "^3.0.7",
    "@ai-sdk/provider-utils": "^3.0.16",
    "@ai-sdk/react": "^3.0.72",
    "@built-in-ai/core": "^2.0.1",
    "@built-in-ai/transformers-js": "^0.1.0",
    "@chakra-ui/react": "^3.29.0",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@react-three/fiber": "^9.4.0",
    "@react-three/postprocessing": "^3.0.4",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/three": "^0.181.0",
    "ai": "^6.0.70",
    "chalk": "^5.6.2",
    "es-toolkit": "^1.44.0",
    "framer-motion": "^12.23.24",
    "kokoro-js": "^1.2.1",
    "localforage": "^1.10.0",
    "marked": "^17.0.0",
    "marked-terminal": "^7.3.0",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "postprocessing": "^6.38.0",
    "react": "^19.2.0",
    "react-console-emulator": "^5.0.2",
    "react-dom": "^19.2.0",
    "react-hotkeys-hook": "^5.2.1",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.181.1",
    "tokenlens": "^1.3.1",
    "wavesurfer.js": "^7.8.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.11"
  },
  "overrides": {
    "ai": "^6.0.70"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-tsconfig-paths": "^4.3.2"
  }
}
