# Server env (alternative location). In dev the server also loads ../../.env from project root.
NODE_ENV=development
PORT=3002
CORS_ORIGIN=http://localhost:5173

# NVIDIA NIM (OpenAI-compatible) fallback when OPENAI_API_KEY/OPENAI_BASE_URL are not configured.
NVIDIA_NIM_API_KEY=
# NVIDIA_API_KEY=
# NIM speech-to-text model for server-side transcription (default: nvidia/parakeet-ctc-1.1b-asr).
# NIM_TRANSCRIPTION_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ZEN_API_KEY=

ENABLE_TTS_PROXY=false
ENABLE_VOICE_CLONING=false



# Render.com diagnostics (optional, local tooling; never commit secrets)
# RENDER_API_KEY=
# RENDER_SERVICE_ID=
# RENDER_OWNER_ID=
