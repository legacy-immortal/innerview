# Server env (alternative location). In dev the server also loads ../../.env from project root.
NODE_ENV=development
PORT=3002
CORS_ORIGIN=http://localhost:5173

OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ZEN_API_KEY=

ENABLE_TTS_PROXY=false
ENABLE_VOICE_CLONING=false

# Turso/libSQL vector memory (optional; falls back to in-memory if unset)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
DATABASE_URL=
VECTOR_DB_URL=
