# Server env (alternative location). In dev the server also loads ../../.env from project root.
NODE_ENV=development
PORT=3002
CORS_ORIGIN=http://localhost:5173

# NVIDIA NIM (OpenAI-compatible) fallback when OPENAI_API_KEY/OPENAI_BASE_URL are not configured.
NVIDIA_NIM_API_KEY=
# NVIDIA_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ZEN_API_KEY=

ENABLE_TTS_PROXY=false
ENABLE_VOICE_CLONING=false

# Turso/libSQL vector memory
# Local development (default): file-backed DB (no token needed)
TURSO_DATABASE_URL=file:server/data/local-vector.db
# TURSO_AUTH_TOKEN=
# Cloud (e.g. Turso remote) — set when ready (keep token server-side only)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
DATABASE_URL=
VECTOR_DB_URL=
