# Midscene + NVIDIA NIM (OpenAI-compatible) configuration for agentic e2e tests.
# Copy to e2e/.env and set your key. e2e/.env is gitignored.

# Required for agentic (Midscene AI) tests: NVIDIA NIM API key (keep secret; do not commit)
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
# MIDSCENE_MODEL_API_KEY is populated from NVIDIA_NIM_API_KEY by the sentinel if unset.

# NVIDIA NIM OpenAI-compatible endpoint (remote VLLM)
MIDSCENE_MODEL_BASE_URL=https://integrate.api.nvidia.com/v1

# Model selection (sentinel updates MIDSCENE_MODEL_NAME before each agentic run)
# Sentinel FAILS if no capable remote vision-capable VLLM can be selected (no local VLLM fallback).
# Examples: nvidia/nemotron-3.5-super-vl-120b-a12b, meta/llama-3.2-90b-vision-instruct
MIDSCENE_MODEL_NAME=nvidia/nemotron-3.5-super-vl-120b-a12b

# Midscene model family/adapter. Must match the selected model.
# Common families: qwen3.5, qwen3-vl, qwen2.5-vl, doubao-seed, doubao-vision, glm-v, gemini, gpt-5, ui-tars
MIDSCENE_MODEL_FAMILY=qwen3-vl

# Sentinel behavior:
# - Default (1): require a capable remote VLLM; fail fast if unavailable (agentic tests).
# - Set to 0 ONLY for explicit non-agentic/dry runs (no AI model required).
E2E_REQUIRE_REMOTE_VLLM=1

# Performance budgets (parameterized; tests fail when exceeded). Adjust per target/environment.
E2E_PERF_MAX_LOAD_MS=5000
E2E_PERF_MAX_DCL_MS=3000
E2E_PERF_MAX_RESPONSE_MS=1500
E2E_PERF_MAX_SCRIPT_DURATION_MS=2000
E2E_PERF_MAX_TASK_DURATION_MS=4000
E2E_PERF_MAX_LAYOUT_COUNT=500
E2E_PERF_MAX_CONSOLE_ERRORS=0
E2E_PERF_MAX_PAGE_ERRORS=0

# Optional: increase if agentic tests are flaky/slow
# MIDSCENE_REPLANNING_CYCLE_LIMIT=30
